# Copy this file to .env and fill in the values from your Firebase project
# (Firebase console → Project settings → General → Your apps → web app config).
# These are safe to expose in the client bundle — access is actually controlled
# by Firestore security rules (firestore.rules), not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
